to_do_list = [
    {"task": "Practice coding for an hour", "Completed": False},
    {"task": "Clean my room", "Completed": False},
    {"task": "Do the dishes", "Completed": False},
    {"task": "Gain 500 Elo on CODM", "Completed": False},
    {"task": "Get 5k Mastery Points on the LW3 - Tundra", "Completed": False}
]



while True:
    print("1. View tasks")
    print("2. Add task")
    print("3. Mark task complete")
    print("4. Quit")
    choice = input("Choose an option: ")

    found = False

    if choice == "1":
        for item in to_do_list:
           status = "✓" if item["Completed"] else "○"
           print(f"{status} {item['task']}")
    elif choice == "2":
        task_name = input("What task would you like to add? ")
        new_task = {"task": task_name, "Completed": False}
        to_do_list.append(new_task)
        print(f"Task '{task_name}' added to the list.")
    elif choice == "3":
        task_name = input("What task did you complete? ")
        for item in to_do_list:
            if item["task"] == task_name:
                item["Completed"] = True
                found = True
                break
        if found:
            print("Task Found!")
        else:
            print("Task not found, try again.")

    elif choice == "4":
        break
    else:
        print("Invalid option, try again.")
